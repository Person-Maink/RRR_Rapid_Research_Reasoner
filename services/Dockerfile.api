FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN pip install --no-cache-dir \
    faiss-cpu \
    fastapi \
    numpy \
    pika \
    psycopg2-binary \
    pydantic \
    pypdf \
    python-multipart \
    uvicorn[standard]

COPY services /app/services
COPY shared /app/shared

EXPOSE 8000
CMD ["uvicorn", "services.api_gateway.main:app", "--host", "0.0.0.0", "--port", "8000"]
