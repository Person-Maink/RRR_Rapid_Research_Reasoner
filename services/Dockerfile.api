FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    VIRTUAL_ENV=/app/services/.venv \
    PATH="/app/services/.venv/bin:$PATH"

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY services/pyproject.toml services/uv.lock services/README.md /app/services/
WORKDIR /app/services
RUN uv sync --frozen

COPY services /app/services
COPY shared /app/shared

EXPOSE 8000
CMD ["uvicorn", "services.api_gateway.main:app", "--host", "0.0.0.0", "--port", "8000"]
